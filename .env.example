# Copy to .env for local development only.
# Do not commit real secrets.
# Defaults are safe for disposable local development only and are refused when APP_ENV=production.

APP_ENV=development
APP_NAME=task-manager
SERVER_PORT=8080
SERVER_BASE_URL=http://server:8080

POSTGRES_DB=task_manager
POSTGRES_USER=task_manager
POSTGRES_PASSWORD=task_manager
POSTGRES_PORT=5432
DATABASE_URL=postgres://task_manager:task_manager@postgres:5432/task_manager?sslmode=disable

MINIO_ROOT_USER=task-manager-dev
MINIO_ROOT_PASSWORD=task-manager-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY_ID=task-manager-dev
S3_SECRET_ACCESS_KEY=task-manager-dev-secret
S3_BUCKET=task-manager-dev
S3_USE_SSL=false
